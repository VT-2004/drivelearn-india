generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  school_owner
  instructor
  learner
}

enum VerificationStatus {
  pending
  verified
  rejected
  suspended
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum SubscriptionPlan {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  expired
}

enum AttendanceStatus {
  present
  absent
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  phone         String
  role          Role
  createdAt     DateTime       @default(now())

  drivingSchool DrivingSchool?
  instructor    Instructor?
  bookings      Booking[]
  reviews       Review[]
  lessonUpdates LessonUpdate[]
  notifications Notification[]
  walletBalance Float          @default(0)
  googleId      String?        @unique
}

model DrivingSchool {
  id                  Int                @id @default(autoincrement())
  ownerId             Int                @unique
  owner               User               @relation(fields: [ownerId], references: [id])
  name                String
  description         String?
  city                String
  state               String
  address             String
  latitude            Float?
  longitude           Float?
  verificationStatus  VerificationStatus @default(pending)
  suspensionReason    String?
  documentsUrl        String?
  createdAt           DateTime           @default(now())

  branches            Branch[]
  instructors         Instructor[]
  courses             Course[]
  subscriptions       Subscription[]
  reviews             Review[]
  vehicles            Vehicle[]
}

model Branch {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  school    DrivingSchool @relation(fields: [schoolId], references: [id])
  city      String
  state     String
  address   String
}

model Instructor {
  id               Int           @id @default(autoincrement())
  userId           Int           @unique
  user             User          @relation(fields: [userId], references: [id])
  schoolId         Int
  school           DrivingSchool @relation(fields: [schoolId], references: [id])
  specialization   String?
  experienceYears  Int?

  bookings         Booking[]
  availabilitySlots AvailabilitySlot[]
  courses          Course[]
  vehicles         Vehicle[]
  leaves           InstructorLeave[]
}

model InstructorLeave {
  id           Int        @id @default(autoincrement())
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  date         DateTime
  reason       String?
  createdAt    DateTime   @default(now())

  @@unique([instructorId, date])
}

model Course {
  id            Int           @id @default(autoincrement())
  schoolId      Int
  school        DrivingSchool @relation(fields: [schoolId], references: [id])
  instructorId  Int?
  instructor    Instructor?   @relation(fields: [instructorId], references: [id])
  title         String
  description   String?
  price         Decimal
  durationDays  Int

  bookings      Booking[]
}

model Booking {
  id            Int           @id @default(autoincrement())
  learnerId     Int
  learner       User          @relation(fields: [learnerId], references: [id])
  courseId      Int
  course        Course        @relation(fields: [courseId], references: [id])
  instructorId  Int
  instructor    Instructor    @relation(fields: [instructorId], references: [id])
  status        BookingStatus @default(pending)
  bookedDate    DateTime
  createdAt     DateTime      @default(now())

  payment       Payment?
  attendance    Attendance[]
  updates       LessonUpdate[]
  slotId        Int?               @unique
  slot          AvailabilitySlot?  @relation(fields: [slotId], references: [id])
  startTime     String?
  endTime       String?
}

model Payment {
  id               Int           @id @default(autoincrement())
  bookingId        Int           @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  amount           Decimal
  status           PaymentStatus @default(pending)
  razorpayOrderId  String?
  paidAt           DateTime?
  walletUsed       Decimal?      @default(0)
}

model Subscription {
  id         Int                 @id @default(autoincrement())
  schoolId   Int
  school     DrivingSchool       @relation(fields: [schoolId], references: [id])
  plan       SubscriptionPlan
  status     SubscriptionStatus  @default(active)
  startDate  DateTime
  endDate    DateTime
}

model Review {
  id         Int           @id @default(autoincrement())
  learnerId  Int
  learner    User          @relation(fields: [learnerId], references: [id])
  schoolId   Int
  school     DrivingSchool @relation(fields: [schoolId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
}

model Attendance {
  id            Int               @id @default(autoincrement())
  bookingId     Int
  booking       Booking           @relation(fields: [bookingId], references: [id])
  date          DateTime
  status        AttendanceStatus
  notes         String?
  checkInTime   DateTime?
  checkOutTime  DateTime?
}

model LessonUpdate {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  booking    Booking  @relation(fields: [bookingId], references: [id])
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  authorRole String
  message    String
  createdAt  DateTime @default(now())
}


model AvailabilitySlot {
  id           Int         @id @default(autoincrement())
  instructorId Int
  instructor   Instructor  @relation(fields: [instructorId], references: [id])
  date         DateTime
  startTime    String
  endTime      String
  isBooked     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  booking      Booking?
}

model Vehicle {
  id                  Int           @id @default(autoincrement())
  schoolId            Int
  school              DrivingSchool @relation(fields: [schoolId], references: [id])
  instructorId        Int?
  instructor          Instructor?   @relation(fields: [instructorId], references: [id])
  regNumber           String        // e.g. "OD-02-AB-4471"
  type                String        @default("4-Wheeler") // "4-Wheeler" | "2-Wheeler"
  model               String        // "Maruti Suzuki Swift"
  transmission        String        @default("Manual") // "Manual" | "Automatic"
  fuelType            String        @default("Petrol") // "Petrol" | "CNG" | "Diesel" | "EV"
  dualControlStatus   String        @default("Certified Dual-Control") // "Certified Dual-Control" | "Standard Dual-Pedal" | "N/A (2-Wheeler)"
  insuranceValidity   DateTime?
  insurancePolicyNo   String?
  fitnessValidity     DateTime?
  pucValidity         DateTime?
  status              String        @default("In Service") // "In Service" | "Maintenance" | "Out of Service"
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  schoolId  Int?
  title     String
  message   String
  type      String   @default("info") // "warning" | "suspension" | "info" | "success"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}